#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# Faugus Launcher — one-command dev entry point
# Kills stale ports, starts the Python API server, tails logs
# to terminal, then launches the Tauri native window.
# ─────────────────────────────────────────────────────────────
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

LOG_DIR="$SCRIPT_DIR/.agents/logs"
mkdir -p "$LOG_DIR"
SERVER_LOG="$LOG_DIR/server.log"
VITE_LOG="$LOG_DIR/vite.log"

# Find Python
PYTHON=""
for p in python3 python; do
  if command -v "$p" &>/dev/null; then
    if [ -f "$SCRIPT_DIR/.venv/bin/$p" ]; then
      PYTHON="$SCRIPT_DIR/.venv/bin/$p"
    else
      PYTHON="$(command -v "$p")"
    fi
    break
  fi
done

if [ -z "$PYTHON" ]; then
  echo "Error: Python not found"
  exit 1
fi

echo "🚀 Faugus Launcher"
echo "   Python: $PYTHON"
echo "   Logs:   $SERVER_LOG"

# ── Kill anything on our ports ────────────────────────────────
for port_info in "9876 Python" "5173 Vite"; do
  port="${port_info%% *}"
  name="${port_info##* }"
  pid=$(lsof -ti ":$port" 2>/dev/null || true)
  if [ -n "$pid" ]; then
    echo "   Killing stale $name (pid $pid on port $port)"
    kill "$pid" 2>/dev/null || true
    sleep 0.2
    kill -9 "$pid" 2>/dev/null || true
  fi
done

# ── Start the API server ───────────────────────────────────────
# Redirect to file, then tail -f to show in terminal
> "$SERVER_LOG"
$PYTHON -m faugus.server --port 9876 >> "$SERVER_LOG" 2>&1 &
SERVER_PID=$!

# Tail the log so the user sees what's happening
tail -f "$SERVER_LOG" &
TAIL_PID=$!

# Wait for it to be ready
for i in $(seq 1 15); do
  if curl -s http://127.0.0.1:9876/api/system/status >/dev/null 2>&1; then
    echo ""
    echo "   ✅ API ready"
    echo ""
    break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "   ❌ Server failed — check $SERVER_LOG"
    tail -5 "$SERVER_LOG" 2>/dev/null || true
    kill "$TAIL_PID" 2>/dev/null || true
    exit 1
  fi
  sleep 0.5
done

# ── Cleanup on exit ────────────────────────────────────────────
cleanup() {
  echo ""
  echo "   Shutting down..."
  kill "$TAIL_PID" 2>/dev/null || true
  kill "$SERVER_PID" 2>/dev/null || true
  wait "$SERVER_PID" 2>/dev/null || true
  echo "   Done. Logs: $SERVER_LOG"
}
trap cleanup EXIT INT TERM

# ── Launch Tauri ───────────────────────────────────────────────
if command -v ./web/node_modules/.bin/tauri &>/dev/null; then
  echo "   🪟 Launching Tauri..."
  echo ""
  # Vite output goes to file and terminal
  ./web/node_modules/.bin/tauri dev > >(tee "$VITE_LOG") 2>&1
else
  echo "   🌐 No Tauri CLI — opening browser instead"
  $PYTHON -m webbrowser "http://localhost:9876"
  wait "$SERVER_PID"
fi
